# Productie-.env-template — reisblog.ml-westein.nl
# Op de server: kopieer naar .env, vul de <...>-waarden in, draai `php artisan key:generate`.
# Bevat ALLEEN placeholders — nooit echte wachtwoorden in de repo.

APP_NAME="Westein Reisblog"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://reisblog.ml-westein.nl

APP_LOCALE=nl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=nl_NL

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<db-naam>
DB_USERNAME=<db-gebruiker>
DB_PASSWORD=<db-wachtwoord>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=<hostnet-smtp-host>
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=<smtp-gebruiker>
MAIL_PASSWORD=<smtp-wachtwoord>
MAIL_FROM_ADDRESS="website.support@ml-westein.nl"
MAIL_FROM_NAME="${APP_NAME}"

CONTACT_RECIPIENT="website.support@ml-westein.nl"

VITE_APP_NAME="${APP_NAME}"
